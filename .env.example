# Stage 2: all values optional; leaving them unset keeps integrations disabled.
# Do not use NEXT_PUBLIC_ for any credential or encryption key.

# Supabase server configuration (not connected in this stage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_ENABLED=false

# 32 random bytes encoded as base64. Keep in hosting secret settings / a secret manager,
# separately from the database. Do not commit a real value to this file or source control.
ULTRON_ENCRYPTION_KEY_BASE64=

# Stage 4: private operator-only Supabase Auth gate. Keep these server-side.
# Use the public anon/publishable key only; never expose a service-role key to a browser.
ULTRON_OPERATOR_EMAIL=
